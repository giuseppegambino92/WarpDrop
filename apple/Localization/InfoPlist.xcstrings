    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WarpDrop uses the camera to scan another device's QR code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "WarpDrop usa la fotocamera per scansionare il codice QR di un altro dispositivo."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WarpDrop finds your devices on the local network to send files directly between them."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "WarpDrop cerca i tuoi dispositivi sulla rete locale per inviare file direttamente tra loro."
          }
        }
      }
